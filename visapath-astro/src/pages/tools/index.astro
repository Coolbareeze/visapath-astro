---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = [
  { href: '/tools/visa-fee-calculator/', title: 'Visa Fee Calculator', desc: 'Sourced base fees, currency estimates and official fee services.' },
  { href: '/tools/schengen-90-180-calculator/', title: 'Schengen 90/180 Calculator', desc: 'Track days spent across all 29 Schengen countries.' },
  { href: '/tools/passport-validity-checker/', title: 'Passport Validity Checker', desc: 'Compare expiry with a verified date rule.' },
  { href: '/tools/document-checklist-generator/', title: 'Document Checklist', desc: 'Track preparation tasks and consult official checklists.' },
  { href: '/tools/pkr-currency-converter/', title: 'PKR Currency Converter', desc: 'Live rates — PKR to 16 currencies for travel budgeting.' },
  { href: '/tools/visa-processing-time/', title: 'Processing Time Lookup', desc: 'Official processing tools and route-specific timing checks.' },
  { href: '/tools/travel-insurance-calculator/', title: 'Travel Insurance Calculator', desc: 'Add current insurer quotes and optional costs.' },
  { href: '/tools/flight-cost-estimator/', title: 'Flight Cost Estimator', desc: 'Budget actual airfare, baggage and travel quotes.' },
  { href: '/tools/visa-interview-questions/', title: 'Interview Question Practice', desc: 'Practice questions for US, UK, Canada, Schengen interviews.' },
  { href: '/tools/umrah-cost-calculator/', title: 'Umrah Cost Calculator', desc: 'Add quoted flights, hotels, services and transport.' },
  { href: '/tools/visa-expiry-calculator/', title: 'Visa Expiry Calculator', desc: 'Track your authorized stay — avoid accidental overstay.' },
];
---
<BaseLayout
  title="Visa Tools for Pakistani Travelers"
  description="11 free visa calculators and travel tools built for Pakistani passport holders. Fees, times, documents, Umrah costs, Schengen days, insurance, flights."
>
  <section class="max-w-6xl mx-auto px-4 py-10">
    <h1 class="text-4xl font-bold mb-4">Visa & Travel Tools</h1>
    <p class="text-gray-700 mb-10">Free, no sign-up required. Built for Pakistani passport holders.</p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tools.map((t) => (
        <a href={t.href} class="block border border-gray-200 rounded-lg p-6 hover:border-brand-500 hover:shadow-md transition">
          <h3 class="font-semibold text-lg mb-2 text-brand-600">{t.title}</h3>
          <p class="text-gray-600 text-sm">{t.desc}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
