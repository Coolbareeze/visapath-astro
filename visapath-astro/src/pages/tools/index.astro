---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = [
  { href: '/tools/visa-fee-calculator/', title: 'Visa Fee Calculator', desc: 'Government visa fees for 10+ countries, in PKR, USD, GBP, or EUR.' },
  { href: '/tools/schengen-90-180-calculator/', title: 'Schengen 90/180 Calculator', desc: 'Track days spent across all 29 Schengen countries.' },
  { href: '/tools/passport-validity-checker/', title: 'Passport Validity Checker', desc: 'Check if your passport meets the 6-month rule.' },
  { href: '/tools/document-checklist-generator/', title: 'Document Checklist Generator', desc: 'Interactive checklist for every major visa type.' },
];
---
<BaseLayout
  title="Visa Tools for Pakistani Travelers"
  description="Free visa calculators, passport checkers, and travel tools built for Pakistani passport holders. Visa fees, Schengen days, document checklists."
>
  <section class="max-w-6xl mx-auto px-4 py-10">
    <h1 class="text-4xl font-bold mb-4">Visa & Travel Tools</h1>
    <p class="text-gray-700 mb-10">Free, no sign-up required. Built for Pakistani passport holders.</p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tools.map((t) => (
        <a href={t.href} class="block border border-gray-200 rounded-lg p-6 hover:border-brand-500 hover:shadow-md transition">
          <h3 class="font-semibold text-lg mb-2 text-brand-600">{t.title}</h3>
          <p class="text-gray-600 text-sm">{t.desc}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
