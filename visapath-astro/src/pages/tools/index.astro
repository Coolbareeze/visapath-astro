---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = [
  { href: '/tools/schengen-90-180-calculator/', title: 'Schengen 90/180 Calculator', desc: 'Track days across 29 Schengen countries.', available: true },
];
---
<BaseLayout
  title="Visa Tools for Pakistani Travelers"
  description="Free visa calculators, passport checkers, and travel tools built for Pakistani passport holders."
>
  <section class="max-w-6xl mx-auto px-4 py-10">
    <h1 class="text-4xl font-bold mb-4">Visa & Travel Tools</h1>
    <p class="text-gray-700 mb-10">Free, no sign-up required.</p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tools.map((t) => (
        <a href={t.href} class="block border border-gray-200 rounded-lg p-6 hover:border-brand-500 hover:shadow-md transition">
          <h3 class="font-semibold text-lg mb-2 text-brand-600">{t.title}</h3>
          <p class="text-gray-600 text-sm">{t.desc}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
