---
import BaseLayout from '../layouts/BaseLayout.astro';

const tools = [
  { href: '/tools/visa-fee-calculator/', title: 'Visa Fee Calculator', desc: 'Fees for 10+ countries in PKR, USD, GBP, EUR.' },
  { href: '/tools/schengen-90-180-calculator/', title: 'Schengen 90/180 Calculator', desc: 'Track your Schengen days with rolling window.' },
  { href: '/tools/passport-validity-checker/', title: 'Passport Validity Checker', desc: 'Check the 6-month rule for your destination.' },
  { href: '/tools/document-checklist-generator/', title: 'Document Checklist', desc: 'Interactive checklist for every major visa type.' },
  { href: '/tools/pkr-currency-converter/', title: 'Currency Converter', desc: 'Live rates — PKR to 16 currencies.' },
  { href: '/tools/umrah-cost-calculator/', title: 'Umrah Cost Calculator', desc: 'Package estimate — flights, hotels, visa, transport.' },
];

const guides = [
  { href: '/guides/uk-student-visa-pakistan/', title: 'UK Student Visa from Pakistan' },
  { href: '/guides/us-f1-student-visa-pakistan/', title: 'US F1 Student Visa from Pakistan' },
  { href: '/guides/schengen-visa-pakistanis/', title: 'Schengen Visa — Country Comparison' },
  { href: '/guides/canada-visitor-visa-pakistan/', title: 'Canada Visitor Visa from Pakistan' },
  { href: '/guides/umrah-visa-pakistan/', title: 'Umrah Visa for Pakistanis' },
  { href: '/guides/visa-refusal-appeal-guide/', title: 'Visa Refusal — Reasons and Appeal Guide' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'VisaPath.pk',
  url: 'https://www.visapath.pk',
  description: 'Free visa and travel tools for Pakistani travelers.',
};
---
<BaseLayout
  title="VisaPath.pk — Free Visa & Travel Tools for Pakistanis"
  description="11 free calculators and 13 country guides. Visa fees, Schengen days, passport validity, Umrah costs, interview questions — built for Pakistani passport holders."
  schema={schema}
>
  <section class="bg-gradient-to-br from-brand-50 to-white py-16">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Free Visa & Travel Tools for Pakistanis
      </h1>
      <p class="text-lg text-gray-700 mb-8">
        11 calculators and 13 country guides. UK, US, Canada, Schengen, UAE, Turkey, Thailand, Malaysia, Umrah — all free, built for Pakistani passport holders.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/tools/" class="inline-block bg-brand-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-brand-700">
          Browse Tools
        </a>
        <a href="/guides/" class="inline-block bg-white border border-brand-600 text-brand-600 px-8 py-3 rounded-lg font-semibold hover:bg-brand-50">
          Read Guides
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 max-w-6xl mx-auto px-4">
    <h2 class="text-3xl font-bold mb-8">Popular Tools</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tools.map((t) => (
        <a href={t.href} class="block border border-gray-200 rounded-lg p-6 hover:border-brand-500 hover:shadow-md transition">
          <h3 class="font-semibold text-lg mb-2 text-brand-600">{t.title}</h3>
          <p class="text-gray-600 text-sm">{t.desc}</p>
        </a>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href="/tools/" class="text-brand-600 font-medium hover:underline">View all 11 tools →</a>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold mb-8">Latest Guides</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {guides.map((g) => (
          <a href={g.href} class="block bg-white border border-gray-200 rounded-lg p-5 hover:border-brand-500 hover:shadow-md transition">
            <h3 class="font-semibold text-brand-600">{g.title}</h3>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/guides/" class="text-brand-600 font-medium hover:underline">View all 13 guides →</a>
      </div>
    </div>
  </section>
</BaseLayout>
