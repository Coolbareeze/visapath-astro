---
import BaseLayout from '../layouts/BaseLayout.astro';

const tools = [
  { href: '/tools/schengen-90-180-calculator/', title: 'Schengen 90/180 Calculator', desc: 'Track your Schengen days with rolling 180-day window.' },
  { href: '/tools/', title: 'More Tools Coming Soon', desc: 'Visa fee calculator, passport validity, document checklists.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'VisaPath.pk',
  url: 'https://www.visapath.pk',
  description: 'Free visa and travel tools for Pakistani travelers.',
};
---
<BaseLayout
  title="VisaPath.pk — Free Visa & Travel Tools for Pakistanis"
  description="Free visa calculators, document checklists, and country guides for Pakistani travelers. UK, US, Canada, Schengen, UAE and more."
  schema={schema}
>
  <section class="bg-gradient-to-br from-brand-50 to-white py-16">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Free Visa & Travel Tools for Pakistanis
      </h1>
      <p class="text-lg text-gray-700 mb-8">
        Calculate visa fees, track Schengen days, check passport validity, and get country-specific guides — all free.
      </p>
      <a href="/tools/" class="inline-block bg-brand-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-brand-700">
        Browse All Tools
      </a>
    </div>
  </section>

  <section class="py-16 max-w-6xl mx-auto px-4">
    <h2 class="text-3xl font-bold mb-8">Popular Tools</h2>
    <div class="grid md:grid-cols-2 gap-6">
      {tools.map((t) => (
        <a href={t.href} class="block border border-gray-200 rounded-lg p-6 hover:border-brand-500 hover:shadow-md transition">
          <h3 class="font-semibold text-lg mb-2 text-brand-600">{t.title}</h3>
          <p class="text-gray-600 text-sm">{t.desc}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
