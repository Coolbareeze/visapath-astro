---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Visa Guides for Pakistani Travelers"
  description="Country-specific visa guides for Pakistanis — UK, US, Canada, Schengen, UAE, Turkey, Thailand, and more."
>
  <section class="max-w-3xl mx-auto px-4 py-10">
    <h1 class="text-4xl font-bold mb-4">Visa Guides</h1>
    <p class="text-gray-700 mb-10">
      Country-by-country visa guides written for Pakistani passport holders. New guides are added weekly.
    </p>
    <div class="bg-brand-50 border border-brand-500 rounded-lg p-6">
      <p class="text-gray-700">
        First guides launching soon. In the meantime, try our
        <a href="/tools/schengen-90-180-calculator/" class="text-brand-600 underline font-medium">Schengen Calculator</a>.
      </p>
    </div>
  </section>
</BaseLayout>
