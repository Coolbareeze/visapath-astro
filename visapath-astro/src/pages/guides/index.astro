---
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = [
  { href: '/guides/uk-student-visa-pakistan/', title: 'UK Student Visa from Pakistan — Complete 2026 Guide', excerpt: 'CAS, financial requirements, interview, Graduate Route, timeline.' },
  { href: '/guides/us-b1-b2-visa-pakistan/', title: 'US B1/B2 Visa from Pakistan — Step by Step', excerpt: 'DS-160, MRV fee, interview, 214(b) refusals, dropbox eligibility.' },
  { href: '/guides/us-f1-student-visa-pakistan/', title: 'US F1 Student Visa from Pakistan — Complete Guide', excerpt: 'I-20, SEVIS, DS-160, interview, OPT, STEM extension.' },
  { href: '/guides/schengen-visa-pakistanis/', title: 'Schengen Visa for Pakistanis — Country Comparison', excerpt: 'Compare processing, approval rates, requirements across 10 countries.' },
  { href: '/guides/canada-visitor-visa-pakistan/', title: 'Canada Visitor Visa from Pakistan — Complete Guide', excerpt: 'TRV, Super Visa, biometrics, documents, processing times.' },
  { href: '/guides/australia-visitor-visa-pakistan/', title: 'Australia Visitor Visa (600) from Pakistan', excerpt: 'Four streams, Section 8503, financial requirements, processing.' },
  { href: '/guides/uae-visa-types-pakistan/', title: 'UAE Visa from Pakistan — All Types Explained', excerpt: 'Tourist, 5-year multiple, Golden Visa, employment, family residence.' },
  { href: '/guides/turkey-evisa-pakistan/', title: 'Turkey e-Visa from Pakistan — Complete Guide', excerpt: 'Qualifying visa condition, e-Visa vs sticker visa, Istanbul tips.' },
  { href: '/guides/thailand-dtv-visa-pakistan/', title: 'Thailand DTV Visa from Pakistan — Complete Guide', excerpt: '5-year digital nomad visa, financial requirement, application routes.' },
  { href: '/guides/malaysia-evisa-pakistan/', title: 'Malaysia eVisa and eNTRI from Pakistan', excerpt: 'eVisa vs eNTRI, application steps, costs, KL travel tips.' },
  { href: '/guides/umrah-visa-pakistan/', title: 'Umrah Visa for Pakistanis — Complete Guide', excerpt: 'Nusuk platform, female pilgrims, agents, requirements, 90-day stay.' },
  { href: '/guides/pakistan-passport-renewal/', title: 'Pakistan Passport Renewal — Complete Guide', excerpt: 'MRP vs e-Passport, fees, urgent service, DGIP offices, overseas renewal.' },
  { href: '/guides/visa-refusal-appeal-guide/', title: 'Visa Refusal — Reasons and Appeal Guide', excerpt: 'Common refusal reasons, 214(b), appeal rights, successful reapplication.' },
];
---
<BaseLayout
  title="Visa Guides for Pakistani Travelers"
  description="13 country-specific visa guides for Pakistani passport holders — UK, US, Canada, Schengen, UAE, Turkey, Thailand, Malaysia, Umrah, passport renewal, refusals."
>
  <section class="max-w-3xl mx-auto px-4 py-10">
    <h1 class="text-4xl font-bold mb-4">Visa Guides</h1>
    <p class="text-gray-700 mb-10">
      Country-by-country visa guides written for Pakistani passport holders. In-depth, up-to-date, no fluff.
    </p>
    <div class="space-y-6">
      {guides.map((g) => (
        <a href={g.href} class="block border border-gray-200 rounded-lg p-6 hover:border-brand-500 hover:shadow-md transition">
          <h2 class="font-semibold text-xl mb-2 text-brand-600">{g.title}</h2>
          <p class="text-gray-600 text-sm">{g.excerpt}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
