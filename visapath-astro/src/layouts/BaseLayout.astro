---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schema?: object | object[];
}

const { title, description, canonical, ogImage, schema } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <SEO title={title} description={description} canonical={canonical} ogImage={ogImage} schema={schema} />
</head>
<body class="min-h-screen flex flex-col bg-white text-gray-900 antialiased">
  <Header />
  <main class="flex-1"><slot /></main>
  <Footer />
</body>
</html>
