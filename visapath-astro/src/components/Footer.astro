---
const year = new Date().getFullYear();
---
<footer class="border-t border-gray-200 bg-gray-50 mt-16">
  <div class="max-w-6xl mx-auto px-4 py-10 grid md:grid-cols-4 gap-8 text-sm">
   <div>
  <a href="/" class="inline-block mb-3">
    <img src="/logo.png" alt="VisaPath.pk" class="h-10 w-auto" />
  </a>
  <p class="text-gray-600">Free visa & travel tools for Pakistani travelers.</p>
</div>
    <div>
      <h4 class="font-semibold mb-3">Tools</h4>
      <ul class="space-y-2 text-gray-600">
        <li><a href="/tools/schengen-90-180-calculator/" class="hover:text-brand-600">Schengen Calculator</a></li>
        <li><a href="/tools/" class="hover:text-brand-600">All Tools</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-semibold mb-3">Site</h4>
      <ul class="space-y-2 text-gray-600">
        <li><a href="/about/" class="hover:text-brand-600">About</a></li>
        <li><a href="/contact/" class="hover:text-brand-600">Contact</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-semibold mb-3">Legal</h4>
