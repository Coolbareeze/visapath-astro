        <li><a href="/terms/" class="hover:text-brand-600">Terms</a></li>
        <li><a href="/disclaimer/" class="hover:text-brand-600">Disclaimer</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-gray-200 py-4 text-center text-xs text-gray-500">
    © {year} VisaPath.pk · Information only — verify with official sources.
  </div>
</footer>
